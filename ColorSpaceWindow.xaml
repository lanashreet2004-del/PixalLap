<Window x:Class="PixalLap.ColorSpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PixalLap.Views"
        Title="Color Space Explorer"
        Height="700"
        Width="1000"
        Background="#1E1E1E">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Controls -->
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Visualization:"
                       Foreground="White"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="VisualizationComboBox"
                      Width="200"
                      Height="30"
                      SelectionChanged="VisualizationComboBox_SelectionChanged">

                <ComboBoxItem Content="RGB Cube"/>
                <ComboBoxItem Content="RGB Plane"/>

            </ComboBox>

        </StackPanel>

        <!-- Visualization Area -->
        <Border Grid.Row="1"
                Background="Black"
                CornerRadius="10"
                Padding="10">

            <ContentControl x:Name="VisualizationContent"/>

        </Border>

    </Grid>

</Window>