<Window x:Class="PixalLap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelLab"
        Height="600"
        Width="1000">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- مكان عرض الصورة -->
        <Border Grid.Column="0"
        Margin="10"
        BorderBrush="Gray"
        BorderThickness="2"
        Background="LightGray"
        AllowDrop="True"
        Drop="ImageDropArea_Drop"
        DragOver="ImageDropArea_DragOver">

            <Image x:Name="MainImage"
           Stretch="Uniform"/>

        </Border>
        <!-- الأزرار -->
        <StackPanel Grid.Column="1"
                    Margin="10">

            <Button Content="Open Image"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="OpenImage_Click"/>
            <Button Content="Save Image"
        Height="40"
        Margin="0,0,0,10"
        Click="SaveImage_Click"/>
            <Button Content="Reset Image"
        Height="40"
        Margin="0,0,0,10"
        Click="ResetImage_Click"/>

            <TextBlock Text="Color Space"
           FontWeight="Bold"
           Margin="0,10,0,5"/>

            <ComboBox x:Name="ColorSpaceComboBox"
          SelectedIndex="0"
          Margin="0,0,0,20">

                <ComboBoxItem Content="RGB"/>
                <ComboBoxItem Content="HSV"/>
                <ComboBoxItem Content="CMYK"/>

            </ComboBox>

            <TextBlock Text="Red"/>
            <Slider x:Name="RedSlider"
        Minimum="0"
        Maximum="2"
        Value="1"
        TickFrequency="0.1"
        ValueChanged="RGBSlider_ValueChanged"/>

            <TextBlock x:Name="RedValueText"
           Text="1.0"
           Margin="0,0,0,10"/>

            <TextBlock Text="Green"/>
            <Slider x:Name="GreenSlider"
        Minimum="0"
        Maximum="2"
        Value="1"
        TickFrequency="0.1"
        ValueChanged="RGBSlider_ValueChanged"/>

            <TextBlock x:Name="GreenValueText"
           Text="1.0"
           Margin="0,0,0,10"/>

            <TextBlock Text="Blue"/>
            <Slider x:Name="BlueSlider"
        Minimum="0"
        Maximum="2"
        Value="1"
        TickFrequency="0.1"
        ValueChanged="RGBSlider_ValueChanged"/>

            <TextBlock x:Name="BlueValueText"
           Text="1.0"
           Margin="0,0,0,10"/>

        </StackPanel>

    </Grid>

</Window>